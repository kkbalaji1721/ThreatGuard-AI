MONGODB_ATLAS_VECTOR_SEARCH=false
VECTOR_INDEX_NAME=vector_index
APP_API_KEY=change-this-demo-api-key
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
